<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<Platforms>x64</Platforms>
		<CsWinRTWindowsMetadata>10.0.26100.0</CsWinRTWindowsMetadata>
		<SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.VCRTForwarders.140" Version="1.1.0" />
	  <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\VirtualControllerShared\VirtualControllerShared.csproj" />
    <ProjectReference Include="..\VirtualControllerNative\VirtualControllerNative.vcxproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Content</OutputItemType>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </ProjectReference>
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="VirtualControllerNative.Interop">
	    <HintPath>..\VirtualControllerShared\VirtualControllerNative.Interop.dll</HintPath>
	  </Reference>
	</ItemGroup>

</Project>
